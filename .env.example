# ==========================================
# Ap Desktop Environment Configuration
# ==========================================

# Port Configuration
PORT=5173
VITE_PORT=5173

# Spring Boot Backend Sidecar
# Port 0 instructs Spring Boot to bind to an OS-assigned dynamic loopback port
SERVER_PORT=0
SERVER_ADDRESS=127.0.0.1

# SQLite Database
SQLITE_DB_PATH=data/ap_database.sqlite

# Security & Authentication (Auto-generated by Electron main process if empty)
# AP_INTERNAL_TOKEN=256_bit_cryptographic_hex_token

# Optional External Automation Integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
USER_PHONE_NUMBER=

GOOGLE_SHEET_ID=
N8N_WEBHOOK_URL=

# Optional PostgreSQL 16 Lab Connection
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
